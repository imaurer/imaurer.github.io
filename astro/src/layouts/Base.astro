---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogType?: string;
  ogImage?: string;
}

const { title, description, ogType = 'website', ogImage = '/og/site.png' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
const pageTitle = title === 'Ian Maurer' ? title : `${title} · Ian Maurer`;
const path = Astro.url.pathname;
const navItems = [
  { href: '/writing/', label: 'Writing' },
  { href: '/talks/', label: 'Talks' },
  { href: '/projects/', label: 'Projects' },
  { href: '/papers/', label: 'Papers' },
  { href: '/about/', label: 'About' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Ian Maurer"
      href={new URL('rss.xml', Astro.site)}
    />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Ian Maurer" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <script is:inline>
      (function () {
        var theme = 'dark';
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') theme = stored;
        } catch (e) {}
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="wordmark" href="/">Ian Maurer</a>
        <nav class="site-nav">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                aria-current={path.startsWith(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
          <button
            class="theme-toggle"
            id="theme-toggle"
            type="button"
            aria-label="Toggle color theme"
          >
            <svg
              class="icon-sun"
              viewBox="0 0 256 256"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M120,40V16a8,8,0,0,1,16,0V40a8,8,0,0,1-16,0Zm72,88a64,64,0,1,1-64-64A64.07,64.07,0,0,1,192,128Zm-16,0a48,48,0,1,0-48,48A48.05,48.05,0,0,0,176,128ZM58.34,69.66A8,8,0,0,0,69.66,58.34l-16-16A8,8,0,0,0,42.34,53.66Zm0,116.68-16,16a8,8,0,0,0,11.32,11.32l16-16a8,8,0,0,0-11.32-11.32ZM192,72a8,8,0,0,0,5.66-2.34l16-16a8,8,0,0,0-11.32-11.32l-16,16A8,8,0,0,0,192,72Zm5.66,114.34a8,8,0,0,0-11.32,11.32l16,16a8,8,0,0,0,11.32-11.32ZM48,128a8,8,0,0,0-8-8H16a8,8,0,0,0,0,16H40A8,8,0,0,0,48,128Zm80,80a8,8,0,0,0-8,8v24a8,8,0,0,0,16,0V216A8,8,0,0,0,128,208Zm112-88H216a8,8,0,0,0,0,16h24a8,8,0,0,0,0-16Z" />
            </svg>
            <svg
              class="icon-moon"
              viewBox="0 0 256 256"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M233.54,142.23a8,8,0,0,0-8-2,88.08,88.08,0,0,1-109.8-109.8,8,8,0,0,0-10-10,104.84,104.84,0,0,0-52.91,37A104,104,0,0,0,136,224a103.09,103.09,0,0,0,62.52-20.88,104.84,104.84,0,0,0,37-52.91A8,8,0,0,0,233.54,142.23ZM188.9,190.34A88,88,0,0,1,65.66,67.11a89,89,0,0,1,31.4-26A106,106,0,0,0,96,56,104.11,104.11,0,0,0,200,160a106,106,0,0,0,14.92-1.06A89,89,0,0,1,188.9,190.34Z" />
            </svg>
          </button>
        </nav>
      </div>
    </header>
    <main>
      <div class="container">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="container">
        <div class="links">
          <a href="https://github.com/imaurer" aria-label="GitHub" title="GitHub">
            <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
            </svg>
          </a>
          <a href="https://x.com/imaurer" aria-label="X (Twitter)" title="X (Twitter)">
            <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M9.52 6.78 15.48.05h-1.41L8.89 5.9 4.76.05H0l6.25 8.84L0 15.95h1.41l5.47-6.18 4.37 6.18H16L9.52 6.78Zm-1.94 2.19-.63-.88L1.92 1.08h2.17l4.07 5.66.63.88 5.29 7.36h-2.17L7.58 8.97Z" />
            </svg>
          </a>
          <a href="https://www.linkedin.com/in/ianmaurer/" aria-label="LinkedIn" title="LinkedIn">
            <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M14.82 0H1.18C.53 0 0 .52 0 1.16v13.68C0 15.48.53 16 1.18 16h13.64c.65 0 1.18-.52 1.18-1.16V1.16C16 .52 15.47 0 14.82 0ZM4.75 13.63H2.37V5.99h2.38v7.64ZM3.56 4.95a1.38 1.38 0 1 1 0-2.75 1.38 1.38 0 0 1 0 2.75Zm10.07 8.68h-2.37V9.92c0-.89-.02-2.03-1.24-2.03-1.24 0-1.43.97-1.43 1.96v3.78H6.22V5.99H8.5v1.04h.03c.32-.6 1.09-1.24 2.25-1.24 2.4 0 2.85 1.58 2.85 3.64v4.2Z" />
            </svg>
          </a>
          {/* YouTube placeholder — channel not created yet
          <a href="#" aria-label="YouTube" title="YouTube">
            <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M15.67 4.13a2.01 2.01 0 0 0-1.41-1.42C13.01 2.37 8 2.37 8 2.37s-5.01 0-6.26.34c-.69.18-1.23.73-1.41 1.42A21.1 21.1 0 0 0 0 8c0 1.3.11 2.6.33 3.87.18.69.72 1.24 1.41 1.42 1.25.34 6.26.34 6.26.34s5.01 0 6.26-.34a2.01 2.01 0 0 0 1.41-1.42c.22-1.27.33-2.57.33-3.87 0-1.3-.11-2.6-.33-3.87ZM6.4 10.4V5.6L10.56 8 6.4 10.4Z" />
            </svg>
          </a> */}
          <a href="/rss.xml" aria-label="RSS feed" title="RSS feed">
            <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M2.1 13.9a1.9 1.9 0 1 1 0-3.8 1.9 1.9 0 0 1 0 3.8ZM.2 5.4v2.5c4.36 0 7.9 3.54 7.9 7.9h2.5C10.6 10.06 5.94 5.4.2 5.4Zm0-5.2v2.5c7.23 0 13.1 5.87 13.1 13.1h2.5C15.8 7.16 8.84.2.2.2Z" />
            </svg>
          </a>
          <a class="llms-link" href="/llms.txt" title="llms.txt">llms.txt</a>
        </div>
        <p>Opinions mine — not medical advice, not my employer's positions.</p>
        <p>
          Text licensed
          <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.
        </p>
      </div>
    </footer>
    <script is:inline>
      document
        .getElementById('theme-toggle')
        .addEventListener('click', function () {
          var next =
            document.documentElement.dataset.theme === 'dark'
              ? 'light'
              : 'dark';
          document.documentElement.dataset.theme = next;
          try {
            localStorage.setItem('theme', next);
          } catch (e) {}
        });
    </script>
  </body>
</html>

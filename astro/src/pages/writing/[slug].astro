---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('writing', ({ data }) => !data.external);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) => d.toISOString().slice(0, 10);
---

<Base
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  ogImage={`/og/writing/${post.id}.png`}
>
  <h1>{post.data.title}</h1>
  <p class="meta-line">
    {fmt(post.data.date)}
    {post.data.updated && <span> · updated {fmt(post.data.updated)}</span>}
    · {post.data.category}
    {post.data.draft && <span class="draft-badge">draft</span>}
  </p>
  {
    post.data.tags && (
      <p>
        {post.data.tags.map((t) => (
          <span class="tag">{t}</span>
        ))}
      </p>
    )
  }
  <Content />
  <p class="more-link"><a href="/writing/">More writing →</a></p>
</Base>

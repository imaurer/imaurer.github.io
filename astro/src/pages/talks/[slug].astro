---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const talks = await getCollection('talks');
  return talks.map((talk) => ({ params: { slug: talk.id }, props: { talk } }));
}

const { talk } = Astro.props;
const { Content } = await render(talk);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });
const slugify = (label: string) =>
  label
    .toLowerCase()
    .replace(/[^a-z0-9\s-]/g, '')
    .trim()
    .replace(/\s+/g, '-');
---

<Base title={talk.data.title} description={talk.data.description} ogType="article">
  <h1>{talk.data.title}</h1>
  <p class="meta-line">
    {talk.data.event} · {fmt(talk.data.eventDate)} · {talk.data.category}
  </p>

  {
    talk.data.summary &&
      talk.data.summary
        .trim()
        .split(/\n\s*\n/)
        .map((para) => <p>{para}</p>)
  }

  {
    talk.data.takeaways && (
      <>
        <h2>Key takeaways</h2>
        <ul>
          {talk.data.takeaways.map((t) => (
            <li>{t}</li>
          ))}
        </ul>
      </>
    )
  }

  {
    talk.data.youtubeId ? (
      <>
        <h2>Video</h2>
        <div class="video-slot">
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${talk.data.youtubeId}`}
            title={talk.data.title}
            allowfullscreen
          />
        </div>
      </>
    ) : talk.data.episodeUrl ? (
      <p class="listen-link">
        <a href={talk.data.episodeUrl}>
          Listen on {new URL(talk.data.episodeUrl).hostname.replace(/^www\./, '')} →
        </a>
      </p>
    ) : (
      <>
        <h2>Video</h2>
        <div class="video-slot">
          <span>video coming soon</span>
        </div>
      </>
    )
  }
  {
    talk.data.youtubeId && talk.data.episodeUrl && (
      <p class="listen-link">
        <a href={talk.data.episodeUrl}>
          Episode page on {new URL(talk.data.episodeUrl).hostname.replace(/^www\./, '')} →
        </a>
      </p>
    )
  }

  {
    talk.data.chapters && (
      <>
        <h2>Chapters</h2>
        <ul class="chapters">
          {talk.data.chapters.map((c) => (
            <li>
              <span class="time">{c.time}</span>
              <a href={`#${slugify(c.label)}`}>{c.label}</a>
            </li>
          ))}
        </ul>
      </>
    )
  }

  <h2>Transcript</h2>
  <Content />
</Base>
